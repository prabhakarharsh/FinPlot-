# FinPilot Environment Configuration
PORT=3000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Copilot Provider ('gemini', 'anthropic', or 'mock')
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=your-google-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Munim Guardrails & Usage Limits
DAILY_TOKEN_BUDGET=50000
CHAT_MAX_ITERATIONS=6
CHAT_HISTORY_LIMIT=12

# Set to true to allow deterministic AI tool-loop execution when LLM API keys are not yet supplied
ENABLE_DEMO_FALLBACK=true
